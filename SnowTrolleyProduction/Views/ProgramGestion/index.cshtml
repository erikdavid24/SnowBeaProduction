@model SnowTrolleyProduction.Models.ProgramGestionViewModel
@{
    ViewBag.Title = "Gestion de Programa";
}

@section Styles {
    <link href="@Url.Content("~/Content/css/programa-gestion.css")?v=@(new System.IO.FileInfo(Server.MapPath("~/Content/css/programa-gestion.css")).LastWriteTime.Ticks)" rel="stylesheet" />
    <style>
        .ts-material-badge {
            display: inline-flex;
            align-items: center;
            gap: 3px;
            border-radius: 4px;
            padding: 1px 7px;
            font-size: .72rem;
            font-weight: 600;
            margin-top: 3px;
        }

            .ts-material-badge.mat-ok {
                background: #eff6ff;
                color: #2563eb;
                border: 1px solid #bfdbfe;
            }

            .ts-material-badge.mat-sin {
                background: #fef2f2;
                color: #ef4444;
                border: 1px solid #fecaca;
            }

        .ts-header {
            display: flex !important;
            align-items: center !important;
            justify-content: space-between !important;
            gap: 12px !important;
            margin-bottom: 18px !important;
            background: #fff !important;
            border: 1px solid #e8ecf1 !important;
            border-radius: 10px !important;
        }

            .ts-header h4 {
                font-size: 1.15rem !important;
                font-weight: 700 !important;
                color: #3d4465 !important;
                margin: 0 !important;
                white-space: nowrap !important;
            }

        .ts-toolbar {
            display: flex !important;
            align-items: flex-end !important;
            gap: 8px !important;
            flex-wrap: nowrap !important;
            flex-shrink: 0 !important;
        }

        .ts-fiscal-filter {
            border-left: 1px solid #e8ecf1;
            padding-left: 14px;
        }

            .ts-fiscal-filter label {
                font-size: .74rem;
                font-weight: 600;
                color: #7d8499;
                margin: 0 0 3px;
                display: block;
                white-space: nowrap;
            }

            .ts-fiscal-filter .k-datepicker {
                width: 140px;
            }

        img.show-empty {
            width: 120px !important;
            height: 120px !important;
            background-size: 120px 120px !important;
            display: block !important;
            margin: 0 auto !important;
        }
        .kanban-linea-group {
            margin-bottom: 14px;
        }
        .kanban-linea-hdr {
            font-size: .74rem; font-weight: 700; color: #6366f1;
            padding: 4px 4px 4px; letter-spacing: .04em; text-transform: uppercase;
            border-bottom: 1px solid #e0e7ff; margin-bottom: 8px;
        }
    </style>
}

<div class="ts-header">
    <h4><i class="fas fa-cogs" style="margin-right:8px;"></i>Plan de Produccion</h4>
    <div class="ts-toolbar">
        <a href="#" class="btn btn-brand btn-bold" id="btnNuevoPrograma"><i class="fas fa-plus"></i> Nuevo Programa</a>
        <a href="#" class="btn btn-success btn-bold" id="btnSubirExcel"><i class="fas fa-file-excel"></i>&nbsp;Subir Excel</a>
        <div class="ts-fiscal-filter k-d-flex k-flex-col">
            <label for="fiscalWeekPicker">Seleccionar Semana Fiscal</label>
            <div class="k-d-flex k-align-items-center" style="gap:10px;">
                @(Html.Kendo().DatePicker()
                    .Name("fiscalWeekPicker")
                    .DateInput()
                )
                <a href="#" class="btn btn-brand btn-bold" id="btnBuscar"><i class="fas fa-search"></i> Buscar</a>
                <a href="#" class="btn btn-secondary btn-bold" id="btnLimpiar" title="Limpiar filtro"><i class="fas fa-times"></i> Limpiar</a>
            </div>
        </div>
    </div>
</div>

<div id="secPrecargas" style="display:none;margin-bottom:16px;">
    <div class="pg-precarga-hdr">
        <span><i class="fas fa-exclamation-triangle" style="margin-right:6px;"></i>Pendientes de Autorizacion <span id="badgePrecargas" class="pg-precarga-badge">0</span></span>
        <div style="display:flex;gap:8px;">
            @(Html.Kendo().Button().Name("btnVerPrecargas").Content("<i class='fas fa-eye'></i> Ver detalle"))
            @(Html.Kendo().Button().Name("btnAutorizarTodo").Content("<i class='fas fa-check'></i> Autorizar").HtmlAttributes(new { @class = "k-primary" }))
            @(Html.Kendo().Button().Name("btnRechazarTodo").Content("<i class='fas fa-times'></i> Rechazar"))
        </div>
    </div>
</div>

<div class="kt-portlet">
    <div class="kt-portlet__body">
        <div style="display:flex;align-items:center;gap:8px;margin-bottom:12px;">
            <label style="font-size:.78rem;font-weight:600;color:#7d8499;margin:0;">Linea:</label>
            @(Html.Kendo().DropDownList().Name("filterLineaGlobal")
                .DataTextField("text").DataValueField("value")
                .HtmlAttributes(new { style = "width:130px;font-size:.8rem;" })
                .Events(e => e.Change("onFiltrarLineaGlobal")))
        </div>
        <div class="ts-kanban" id="kanbanBoard">
    <div class="ts-kanban-col">
        <div class="ts-kanban-col-header" style="display:flex;align-items:center;justify-content:space-between;gap:8px;">
            <span><i class="fas fa-pause-circle"></i> Requeridos no programados por restricciones
            <span id="cntPendiente" class="ts-kanban-badge" style="background:#e0e7ff;color:#3730a3;"></span></span>
        </div>
        <div class="ts-kanban-col-body" id="bodyPendiente"></div>
    </div>
    <div class="ts-kanban-col">
        <div class="ts-kanban-col-header" style="display:flex;align-items:center;justify-content:space-between;gap:8px;">
            <span><i class="fas fa-clock"></i> Creado
            <span id="cntCreado" class="ts-kanban-badge" style="background:#fde68a;color:#92400e;"></span></span>
        </div>
        <div class="ts-kanban-col-body" id="bodyCreado"></div>
    </div>
    <div class="ts-kanban-col">
        <div class="ts-kanban-col-header" style="display:flex;align-items:center;justify-content:space-between;gap:8px;">
            <span><i class="fas fa-cog"></i> En Proceso
            <span id="cntEnProceso" class="ts-kanban-badge" style="background:#bfdbfe;color:#1e40af;"></span></span>
        </div>
        <div class="ts-kanban-col-body" id="bodyEnProceso"></div>
    </div>
    <div class="ts-kanban-col">
        <div class="ts-kanban-col-header" style="display:flex;align-items:center;justify-content:space-between;gap:8px;">
            <span><i class="fas fa-check-circle"></i> Completado
            <span id="cntCompletado" class="ts-kanban-badge" style="background:#bbf7d0;color:#166534;"></span></span>
        </div>
        <div class="ts-kanban-col-body" id="bodyCompletado"></div>
    </div>
        </div>
    </div>
</div>

@(Html.Kendo().Window().Name("wndExcel").Title("Cargar Plan de Produccion").Visible(false).Modal(true).Width(500)
    .Content(@<text>
        <div class="wnd-excel-body" style="padding:20px;">
            <div style="text-align:center;margin-bottom:20px;">
                <i class="fas fa-file-excel" style="font-size:64px;color:#1d6f42;"></i>
            </div>
            <p style="text-align:center;color:#6b7280;margin-bottom:20px;">Selecciona tu archivo <b>.xlsx</b> para previsualizar antes de cargar.</p>
            <input type="file" id="archivoExcelInput" accept=".xlsx,.xls" class="wnd-excel-file" style="width:100%;margin-bottom:12px;" />
            <div id="excelUploadProgress" style="display:none;margin-top:8px;color:#3b82f6;text-align:center;">
                <i class="fas fa-spinner fa-spin"></i> Procesando archivo...
            </div>
            <div style="margin-top:16px;text-align:right;">
                @(Html.Kendo().Button().Name("btnCancelarExcel").Content("Cancelar")
                    .Events(e => e.Click("function(){ $('#wndExcel').data('kendoWindow').close(); }")))
                @(Html.Kendo().Button().Name("btnPreviewExcel").Content("<i class='fas fa-search'></i> Vista Previa")
                    .HtmlAttributes(new { @class = "k-primary", style = "margin-left:8px;" }))
            </div>
        </div>
    </text>)
)
@(Html.Kendo().Window().Name("wndPreview").Title("Vista Previa - Plan de Produccion").Visible(false).Modal(true).Width(1200).Height(700)
    .Content(@<text>
        <div style="padding:16px;display:flex;flex-direction:column;height:100%;">
            <div style="margin-bottom:12px;display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:8px;">
                <div style="flex:1;min-width:300px;">
                    <span id="previewCountLabel" style="font-size:14px;color:#374151;font-weight:600;"></span>
                    <br/>
                    <span id="previewDuplicateLabel" style="font-size:13px;color:#ef4444;"></span>
                </div>
                <div>
                    @(Html.Kendo().Button().Name("btnEliminarDuplicados").Content("<i class='fas fa-broom'></i> Limpiar Duplicados")
                        .HtmlAttributes(new { style = "margin-right:8px;display:none;" }))
                </div>
            </div>
            <div id="gridPreviewContainer" style="flex:1;min-height:0;"></div>
            <div style="margin-top:16px;display:flex;justify-content:space-between;align-items:center;">
                @(Html.Kendo().Button().Name("btnDescartarPreview").Content("<i class='fas fa-times'></i> Cancelar"))
                @(Html.Kendo().Button().Name("btnConfirmarCarga").Content("<i class='fas fa-check'></i> Pre-Guardar")
                    .HtmlAttributes(new { @class = "k-primary" }))
            </div>
        </div>
    </text>)
)
@(Html.Kendo().Window().Name("wndNuevo").Title("Nuevo Programa").Visible(false).Modal(true).Width(600)
    .Events(e => e.Close("onWndNuevoCerrar"))
    .Content(@<text>
        <div class="wnd-nuevo-body">
            <div class="form-group form-row">
                <div class="form-col">
                    <label class="form-label">Linea *</label>
                    @(Html.Kendo().DropDownList().Name("Id_Linea").DataTextField("Text").DataValueField("Value")
                        .OptionLabel("-- Selecciona Linea --").HtmlAttributes(new { style = "width:100%;", id = "cbLinea" })
                        .DataSource(s => s.Read(r => r.Action("GetLineas","ProgramGestion").Type(HttpVerbs.Get)))
                        .Events(e => e.Change("onLineaChange")))
                </div>
                <div class="form-col">
                    <label class="form-label">Ensamble *</label>
                    @(Html.Kendo().ComboBox().Name("Id_Ensamble").DataTextField("Text").DataValueField("Value")
                        .Placeholder("-- Selecciona Ensamble --").HtmlAttributes(new { style = "width:100%;", id = "cbEnsamble" })
                        .Filter(FilterType.Contains)
                        .DataSource(s => s.Read(r => r.Action("GetEnsambles","ProgramGestion").Data("getLineaData").Type(HttpVerbs.Get)).ServerFiltering(false))
                        .AutoBind(false).Enable(false).Events(e => e.Change("onEnsambleChange")))
                </div>
            </div>
            <div class="form-group">
                <label class="form-label">Programa(s)</label>
                <input type="hidden" id="hdnProgramaSeleccionado" />
                <div id="ladosAutoContainer" style="display:flex;flex-wrap:wrap;gap:6px;margin-top:4px;min-height:36px;padding:8px;border:1px solid #e2e6f0;border-radius:6px;background:#f9fafb;">
                    <span style="color:#b0b7d0;font-size:.82rem;">Selecciona un ensamble para ver los lados...</span>
                </div>
            </div>
            <div class="form-group">
                <label class="form-label">WorkOrder *</label>
                <div class="wo-wrap">
                    @(Html.Kendo().TextBox().Name("txtWorkOrderBase").Readonly(true).HtmlAttributes(new { @class = "wo-base", style = "width:auto;" }))
                    <span class="wo-sep">-</span>
                    @(Html.Kendo().TextBox().Name("txtWorkOrderSufijo").Value("000").HtmlAttributes(new { @class = "wo-suffix", maxlength = "3" }))
                    <input type="hidden" id="hdnWorkOrderFinal" />
                </div>
 
            </div>
            <div class="form-group form-row">
                <div class="form-col">
                    <label class="form-label">Piezas Programadas *</label>
                    @(Html.Kendo().NumericTextBox<int>().Name("txtPiezas").Min(1).HtmlAttributes(new { style = "width:100%;" }))
                </div>
                <div class="form-col">
                    <label class="form-label">Fecha de Inicio *</label>
                    @(Html.Kendo().DatePicker().Name("FechaCreacion").Value(DateTime.Now).Format("yyyy/MM/dd")
                        .HtmlAttributes(new { style = "width:100%;", id = "dpFecha" }))
                </div>
            </div>
            <div class="form-group">
                <label class="form-label">Comentarios</label>
                @(Html.Kendo().TextArea().Name("txtComentarios").Rows(2).HtmlAttributes(new { style = "width:100%;" }))
            </div>
            <div class="form-actions">
                @(Html.Kendo().Button().Name("btnCancelarNuevo").Content("Cancelar"))
                @(Html.Kendo().Button().Name("btnGuardarNuevo").Content("<i class='fas fa-save'></i> Guardar")
                    .HtmlAttributes(new { @class = "k-primary" }))
            </div>
        </div>
    </text>)
)
@(Html.Kendo().Window().Name("wndEditar").Title("Editar Programa").Visible(false).Modal(true).Width(540)
    .Events(e => e.Close("onWndEditarCerrar"))
    .Content(@<text>
        <div class="wnd-nuevo-body">
            <input type="hidden" id="editId" /><input type="hidden" id="editEnsambleVal" />
            <div class="form-group form-row">
                <div class="form-col">
                    <label class="form-label">WorkOrder</label>
                    <div class="wo-wrap">
                        @(Html.Kendo().TextBox().Name("editWorkOrderBase").Readonly(true).HtmlAttributes(new { @class = "wo-base", style = "width:auto;" }))
                        <span class="wo-sep">-</span>
                        @(Html.Kendo().TextBox().Name("editWorkOrderSufijo").HtmlAttributes(new { @class = "wo-suffix", maxlength = "3" }))
                    </div>
                    <input type="hidden" id="editWorkOrder" />
                </div>
                <div class="form-col">
                    <label class="form-label">Piezas Programadas *</label>
                    @(Html.Kendo().NumericTextBox<int>().Name("editPiezas").Min(1).HtmlAttributes(new { style = "width:100%;" }))
                </div>
            </div>
            <div class="form-group">
                <label class="form-label">Ensamble</label>
                @(Html.Kendo().TextBox().Name("editEnsamble").Readonly(true).HtmlAttributes(new { style = "width:100%;background:#f3f6f9;font-weight:600;" }))
            </div>
            <div class="form-group">
                <label class="form-label">Lados</label>
                <div id="editLadosContainer" style="display:flex;flex-wrap:wrap;gap:6px;margin-top:4px;min-height:32px;">
                    <span style="color:#b0b7d0;font-size:.82rem;">Cargando lados...</span>
                </div>
            </div>
            <div class="form-group">
                <label class="form-label">Linea</label>
                @(Html.Kendo().DropDownList().Name("editLinea").DataTextField("Text").DataValueField("Value")
                    .OptionLabel("-- Selecciona Linea --").HtmlAttributes(new { style = "width:100%;" })
                    .DataSource(s => s.Read(r => r.Action("GetLineas", "ProgramGestion").Type(HttpVerbs.Get))))
            </div>
            <input type="hidden" id="editTrolleys" />
            <div class="form-group">
                <label class="form-label">Comentarios</label>
                @(Html.Kendo().TextArea().Name("editComentarios").Rows(2).HtmlAttributes(new { style = "width:100%;" }))
            </div>
            <div class="form-actions">
                @(Html.Kendo().Button().Name("btnCancelarEditar").Content("Cancelar"))
                @(Html.Kendo().Button().Name("btnGuardarEditar").Content("<i class='fas fa-save'></i> Guardar")
                    .HtmlAttributes(new { @class = "k-primary" }))
            </div>
        </div>
    </text>)
)
@(Html.Kendo().Window().Name("wndSetup").Title("Setup de Trolleys").Visible(false).Modal(true).Width(520)
    .Events(e => e.Close("onWndSetupCerrar"))
    .Content(@<text>
        <div class="wnd-nuevo-body">
            <input type="hidden" id="setupProgramaId" />
            <input type="hidden" id="setupLinea" />
            <div class="form-group">
                <label class="form-label">Programa</label>
                @(Html.Kendo().TextBox().Name("setupPrograma").Readonly(true).HtmlAttributes(new { style = "width:100%;background:#f3f6f9;font-weight:600;" }))
            </div>
            <div class="form-group" style="display:none;">
                <label class="form-label">Maquina</label>
                <select id="setupMaquina"></select>
            </div>
            <div class="form-group">
                <label class="form-label">Asignación de Trolleys por Zona</label>
                <div id="setupZonasContainer" style="margin-top:6px;"></div>
                <p id="setupAlertaDuplicados" style="display:none;color:#ef4444;font-size:.82rem;margin-top:6px;">
                    <i class="fas fa-exclamation-triangle"></i> No puedes poner un mismo trolley en dos locaciones diferentes.
                </p>
            </div>
            <div class="form-actions">
                @(Html.Kendo().Button().Name("btnCancelarSetup").Content("Cancelar"))
                @(Html.Kendo().Button().Name("btnGuardarSetup").Content("<i class='fas fa-tools'></i> Guardar Setup")
                    .HtmlAttributes(new { @class = "k-primary" }))
            </div>
        </div>
    </text>)
)

<script>
var PG = {
    urls: {
        readKanban:          '@Url.Action("ReadKanban",          "ProgramGestion")',
        createManual:        '@Url.Action("CreateManual",        "ProgramGestion")',
        editarDirecto:       '@Url.Action("EditarDirecto",       "ProgramGestion")',
        eliminarDirecto:     '@Url.Action("EliminarDirecto",     "ProgramGestion")',
        eliminarCarta:       '@Url.Action("EliminarCarta",       "ProgramGestion")',
        semanaFiscal:        '@Url.Action("GetSemanaFiscal",     "ProgramGestion")',
        getSemanasDelMes:    '@Url.Action("GetSemanasDelMes",    "ProgramGestion")',
        getLadosPorEnsamble: '@Url.Action("GetLadosPorEnsamble", "ProgramGestion")',
        getTrolleysPorLinea: '@Url.Action("GetTrolleysPorLinea", "ProgramGestion")',
        guardarSetupTrolleys:'@Url.Action("GuardarSetupTrolleys","ProgramGestion")',
        cargaMasiva:         '@Url.Action("CargaMasiva",         "ProgramGestion")',
        guardarPreview:      '@Url.Action("GuardarPreview",      "ProgramGestion")',
        preGuardar:          '@Url.Action("PreGuardarPreview",   "ProgramGestion")',
        getPrecargas:        '@Url.Action("GetPrecargas",        "ProgramGestion")',
        autorizarPrecargas:  '@Url.Action("AutorizarPrecargas",    "ProgramGestion")',
        rechazarPrecargas:   '@Url.Action("RechazarPrecargas",     "ProgramGestion")',
        cambiarStatus:       '@Url.Action("CambiarStatusKanban",   "ProgramGestion")'
    },
    msj: {
        exito: '@Html.Raw(TempData["Success"] != null ? TempData["Success"].ToString() : "")',
        error: '@Html.Raw(TempData["Error"]   != null ? TempData["Error"].ToString()   : "")'
    }
};
</script>
<script src="@Url.Content("~/Scripts/programa-gestion.js")?v=@(new System.IO.FileInfo(Server.MapPath("~/Scripts/programa-gestion.js")).LastWriteTime.Ticks)"></script>
