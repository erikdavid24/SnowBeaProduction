@model List<SnowTrolleyProduction.Models.LineaGestion>
@{
    var maquina = ViewBag.Maquina as SnowTrolleyProduction.Models.MaquinaGestion;
    bool esEdicion = maquina != null;
}

@if (esEdicion)
{
    <h4 style="margin-bottom:16px;font-weight:700;color:#3d4465;">Editar M&#225;quina</h4>
}
else
{
    <h4 style="margin-bottom:16px;font-weight:700;color:#3d4465;">Agregar M&#225;quina</h4>
}

@if (esEdicion)
{
    <input type="hidden" id="modalMaquinaId" value="@maquina.Id" />
}

@if (!esEdicion)
{
    <div class="form-group">
        <label class="form-label">Tipo</label>
        <div class="kt-radio-inline">
            <label class="kt-radio">
                <input type="radio" name="modoMaquina" value="existente" checked /> M&#225;quina existente <span></span>
            </label>
            <label class="kt-radio">
                <input type="radio" name="modoMaquina" value="nueva" /> M&#225;quina nueva <span></span>
            </label>
        </div>
    </div>
}

<div class="form-group">
    <label class="form-label">L&#237;nea</label>
    <select id="modalLineaSelect">
        @foreach (var linea in Model)
        {
            if (esEdicion && maquina.Linea != null && maquina.Linea.Id_Linea == linea.Id_Linea)
            {
                <option value="@linea.Id_Linea" selected>@linea.Numero_Linea</option>
            }
            else
            {
                <option value="@linea.Id_Linea">@linea.Numero_Linea</option>
            }
        }
    </select>
</div>

<div class="form-group" id="grpEquipoExistente">
    <label class="form-label">Equipo</label>
    <input id="modalEquipoSelect" style="width:100%;" />
</div>

@if (!esEdicion)
{
    <div class="form-group" id="grpEquipoNuevo" style="display:none;">
        <label class="form-label">Nombre de la m&#225;quina <span class="kt-font-danger">*</span></label>
        <input class="form-control" id="modalEquipoNuevo" placeholder="Escribe el nombre de la nueva m&#225;quina..." />
    </div>
}

<div class="form-actions" style="display:flex;gap:8px;justify-content:flex-end;margin-top:16px;">
    <button type="button" class="btn btn-secondary" onclick="$('#wndGestion').data('kendoWindow').close();">Cancelar</button>
    <button type="button" class="btn btn-primary" id="btnSubmitMaquina"><i class="fas fa-save"></i> @(esEdicion ? "Editar" : "Agregar")</button>
</div>

<script>
(function () {
    var esEdicion = @(esEdicion ? "true" : "false");
    var equipoActual = @(esEdicion && maquina.Equipo != null ? maquina.Equipo.IdEquipo.ToString() : "null");
    var modo = 'existente';

    var $lineaDDL = $('#modalLineaSelect').kendoDropDownList({
        change: cargarEquipos
    }).data('kendoDropDownList');

    var $equipoDDL = $('#modalEquipoSelect').kendoDropDownList({
        dataTextField: 'EquipoDescripcion',
        dataValueField: 'IdEquipo',
        optionLabel: 'Selecciona un equipo...'
    }).data('kendoDropDownList');

    function cargarEquipos() {
        var lineaId = $lineaDDL.value();
        $.get(TG.urls.equiposPorLinea, { lineaId: lineaId, equipoActual: equipoActual }, function (r) {
            $equipoDDL.setDataSource(r.equipos);
            if (equipoActual) $equipoDDL.value(equipoActual);
        });
    }

    cargarEquipos();

    // Cambio entre "maquina existente" y "maquina nueva"
    $('input[name="modoMaquina"]').on('change', function () {
        modo = this.value;
        if (modo === 'nueva') {
            $('#grpEquipoExistente').hide();
            $('#grpEquipoNuevo').show();
        } else {
            $('#grpEquipoNuevo').hide();
            $('#grpEquipoExistente').show();
        }
    });

    $('#btnSubmitMaquina').on('click', function () {
        var lineaId = parseInt($lineaDDL.value());
        var $btn = $(this);

        // --- Crear una maquina NUEVA (nuevo equipo) ---
        if (!esEdicion && modo === 'nueva') {
            var desc = ($('#modalEquipoNuevo').val() || '').trim();
            if (!desc) { tgAlert('Campo requerido', 'Escribe el nombre de la maquina.'); return; }
            $btn.prop('disabled', true);
            $.post(TG.urls.agregarMaquinaNueva, { descripcion: desc, lineaId: lineaId }, function (r) {
                if (r.success) { $('#wndGestion').data('kendoWindow').close(); cargarMaquinas(); }
                else { tgAlert('Error', r.message); }
            }).always(function () { $btn.prop('disabled', false); });
            return;
        }

        // --- Maquina existente (editar o agregar) ---
        var equipoId = parseInt($equipoDDL.value());
        if (!equipoId) { tgAlert('Campo requerido', 'Selecciona un equipo.'); return; }
        $btn.prop('disabled', true);
        if (esEdicion) {
            var maquinaId = parseInt($('#modalMaquinaId').val());
            $.post(TG.urls.editarMaquina, { maquinaId: maquinaId, equipoId: equipoId }, function (r) {
                if (r.success) { $('#wndGestion').data('kendoWindow').close(); cargarMaquinas(); }
                else { tgAlert('Error', r.message); }
            }).always(function () { $btn.prop('disabled', false); });
        } else {
            $.post(TG.urls.agregarMaquina, { equipoId: equipoId, lineaId: lineaId }, function (r) {
                if (r.success) { $('#wndGestion').data('kendoWindow').close(); cargarMaquinas(); }
                else { tgAlert('Error', r.message); }
            }).always(function () { $btn.prop('disabled', false); });
        }
    });
})();
</script>
