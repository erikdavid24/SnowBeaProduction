<div class="gestion-toolbar" style="margin-bottom:8px;">
    <button class="btn btn-primary btn-sm" id="btnAgregarAcomodo"><i class="fas fa-plus"></i> Agregar Acomodo</button>
</div>

@(Html.Kendo().Grid<SnowTrolleyProduction.Models.AcomodoGridRow>()
    .Name("gridAcomodos")
    .HtmlAttributes(new { style = "height: 600px;" })
    .ToolBar(t => t.Search())
    .Columns(cols => {
        cols.Bound(g => g.Programa).Title("Programa");
        cols.Bound(g => g.Ensamble).Title("Ensamble");
        cols.Bound(g => g.Linea).Title("Linea").Width(110);
        cols.Bound(g => g.ProgramaId).Title("Acciones").Width(120)
            .Sortable(false).Filterable(false)
            .HtmlAttributes(new { style = "white-space:nowrap;" })
            .ClientTemplate(
                "<button class='btn btn-icon btn-sm btn-warning btn-edit-acomodo' data-id='#=ProgramaId#' title='Editar'>" +
                "<i class='fas fa-edit'></i></button> " +
                "<button class='btn btn-icon btn-sm btn-danger btn-del-acomodo' data-id='#=ProgramaId#' data-prog='#=Programa#' title='Eliminar'>" +
                "<i class='fas fa-trash-alt'></i></button>");
    })
    .Sortable()
    .Filterable()
    .Resizable(r => r.Columns(true))
    .Reorderable(r => r.Columns(true))
    .ColumnMenu()
    .Scrollable(s => s.Height(550))
    .DataSource(ds => ds.Ajax()
        .Read(r => r.Action("AcomodoJson", "TrolleyGestion"))
        .ServerOperation(false))
)
