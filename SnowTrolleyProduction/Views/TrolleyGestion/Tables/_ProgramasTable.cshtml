<div class="gestion-toolbar" style="margin-bottom:8px;">
    <button class="btn btn-primary btn-sm" id="btnAgregarPrograma"><i class="fas fa-plus"></i> Agregar Programa</button>
</div>

<style>
    /* Reserva siempre la barra vertical y oculta la horizontal para evitar el parpadeo
       del scroll horizontal al cargar los datos (las columnas ya caben en el ancho). */
    #gridProgramas .k-grid-content { overflow-y: scroll; overflow-x: hidden; }
    /* Oculta la barra del wrapper que parpadea al cargar; el scroll real lo maneja
       el contenido interno (.k-grid-content). */
    #gridProgramas { overflow: hidden; }
</style>

@(Html.Kendo().Grid<SnowTrolleyProduction.Models.ProgramaGridRow>()
    .Name("gridProgramas")
    .HtmlAttributes(new { style = "height: 600px;" })
    .ToolBar(t => t.Search())
    .Columns(cols => {
        cols.Bound(p => p.Numero).Title("Programa");
        cols.Bound(p => p.Ensamble).Title("Ensamble");
        cols.Bound(p => p.Linea).Title("Linea").Width(70);
        cols.Bound(p => p.CantDiferentes).Title("Comp. Dif.").Width(105)
            .Sortable(true).Filterable(true)
            .HtmlAttributes(new { style = "text-align:center;" })
            .HeaderHtmlAttributes(new { style = "text-align:center;" })
            .ClientTemplate(
                "# if (CantDiferentes > 0) { #" +
                "<span style='display:inline-flex;align-items:center;background:\\#f0fdf4;color:\\#16a34a;" +
                "border:1px solid \\#bbf7d0;padding:1px 7px;font-size:.78rem;font-weight:600;'>" +
                "#=CantDiferentes#</span>" +
                "# } else { #" +
                "<span style='color:\\#9aa0b8;font-size:.75rem;'>0</span>" +
                "# } #");
        cols.Bound(p => p.CantidadMateriales).Title("Total Mat.").Width(110)
            .Sortable(true).Filterable(true)
            .HtmlAttributes(new { style = "text-align:center;" })
            .HeaderHtmlAttributes(new { style = "text-align:center;" })
            .ClientTemplate(
                "# if (CantidadMateriales > 0) { #" +
                "<span style='display:inline-flex;align-items:center;background:\\#eff6ff;color:\\#2563eb;" +
                "border:1px solid \\#bfdbfe;padding:1px 7px;font-size:.78rem;font-weight:600;'>" +
                "#=CantidadMateriales#</span>" +
                "# } else { #" +
                "<span style='color:\\#ef4444;font-size:.75rem;font-weight:600;'>Sin mat.</span>" +
                "# } #");
        cols.Bound(p => p.Id).Title("Acciones").Width(120)
            .Sortable(false).Filterable(false)
            .HtmlAttributes(new { style = "white-space:nowrap;text-align:center;" })
            .HeaderHtmlAttributes(new { style = "text-align:center;" })
            .ClientTemplate(
                "<button class='btn btn-icon btn-sm btn-warning btn-edit-programa' data-id='#=Id#' title='Editar' " +
                "style='width:32px;height:32px;padding:0;'><i class='fas fa-edit'></i></button> " +
                "<button class='btn btn-icon btn-sm btn-danger btn-del-programa' data-id='#=Id#' title='Eliminar' " +
                "style='width:32px;height:32px;padding:0;'><i class='fas fa-trash-alt'></i></button>");
    })
    .Sortable()
    .Filterable()
    .Resizable(r => r.Columns(true))
    .Reorderable(r => r.Columns(true))
    .ColumnMenu()
    .Scrollable(s => s.Height(550))
    .DataSource(ds => ds.Ajax()
        .Read(r => r.Action("ProgramasJson", "TrolleyGestion"))
        .ServerOperation(false))
)
