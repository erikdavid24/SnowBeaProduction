<div class="gestion-toolbar" style="margin-bottom:8px;">
    <button class="btn btn-primary btn-sm" id="btnAgregarMaquina"><i class="fas fa-plus"></i> Agregar Maquina</button>
</div>

@(Html.Kendo().Grid<SnowTrolleyProduction.Models.MaquinaGridRow>()
    .Name("gridMaquinas")
    .HtmlAttributes(new { style = "height: 600px;" })
    .ToolBar(t => t.Search())
    .Columns(cols => {
        cols.Bound(m => m.Maquina).Title("Maquina");
        cols.Bound(m => m.Linea).Title("Linea").Width(100);
        cols.Bound(m => m.Id).Title("Acciones").Width(120)
            .Sortable(false).Filterable(false)
            .HtmlAttributes(new { style = "white-space:nowrap;" })
            .ClientTemplate(
                "<button class='btn btn-icon btn-sm btn-warning btn-edit-maquina' data-id='#=Id#' title='Editar'>" +
                "<i class='fas fa-edit'></i></button> " +
                "<button class='btn btn-icon btn-sm btn-danger btn-del-maquina' data-id='#=Id#' title='Eliminar'>" +
                "<i class='fas fa-trash-alt'></i></button>");
    })
    .Sortable()
    .Filterable()
    .Resizable(r => r.Columns(true))
    .Reorderable(r => r.Columns(true))
    .ColumnMenu()
    .Scrollable(s => s.Height(550))
    .DataSource(ds => ds.Ajax()
        .Read(r => r.Action("MaquinasJson", "TrolleyGestion"))
        .ServerOperation(false))
)
