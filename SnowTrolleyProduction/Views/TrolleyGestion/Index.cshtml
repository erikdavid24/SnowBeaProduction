@model SnowTrolleyProduction.Models.TrolleyGestionIndexViewModel
@{
    ViewBag.Title = "Gestor de Trolley";
    string ventana = TempData["Ventana"] != null ? TempData["Ventana"].ToString() : "maquinas";
}

@section Styles {
    <link href="~/Content/css/trolley-gestion.css" rel="stylesheet" />
}

<div class="ts-header">
    <h4><i class="fas fa-cogs" style="margin-right:8px;"></i>Gestor de Trolley</h4>
</div>

<script>
function onTabSelect(e) {
    if (e.contentElement) {
        setTimeout(function () { kendo.resize($(e.contentElement)); }, 1);
    }
}
</script>

@{
    var maquinasContent  = Html.Partial("Tables/_MaquinasTable" ).ToHtmlString();
    var ensamblesContent = Html.Partial("Tables/_EnsamblesTable").ToHtmlString();
    var programasContent = Html.Partial("Tables/_ProgramasTable").ToHtmlString();
    var acomodoContent   = Html.Partial("Tables/_AcomodoTable"  ).ToHtmlString();
}

<div class="kt-portlet">
    <div class="kt-portlet__body">
        @(Html.Kendo().TabStrip().Name("tabsGestion")
            .Animation(false)
            .Events(e => e.Select("onTabSelect"))
            .Items(items => {
                items.Add().Text("Maquinas").Selected(ventana == "maquinas")
                    .Content(maquinasContent);

                items.Add().Text("Ensambles").Selected(ventana == "ensambles")
                    .Content(ensamblesContent);
                items.Add().Text("Programas").Selected(ventana == "programas")
                    .Content(programasContent);

                items.Add().Text("Acomodos").Selected(ventana == "acomodos")
                    .Content(acomodoContent);
            })
        )
    </div>
</div>

@(Html.Kendo().Window().Name("wndGestion").Title("").Visible(false).Modal(true).Width(820)
    .Events(e => e.Close("onWndGestionCerrar"))
    .Content(@<text><div id="wndGestionBody"></div></text>)
)

@section Scripts {
@{
    var tgActions = new[] {
        "MaquinasTable", "AgregarMaquinaModal", "EditarMaquinaModal", "EquiposPorLinea",
        "AgregarMaquina", "EditarMaquina", "EliminarMaquina",
        "EnsamblesTable", "AgregarEnsambleModal", "EditarEnsambleModal",
        "AgregarEnsamble", "EditarEnsamble", "EliminarEnsamble",
        "ProgramasTable", "AgregarProgramaModal", "EditarProgramaModal",
        "AgregarPrograma", "EditarPrograma", "EliminarPrograma",
        "AcomodoTable", "AgregarAcomodoModal", "EditarAcomodoModal", "AcomodoAutocompletado",
        "AgregarAcomodo", "EditarAcomodo", "EliminarAcomodo",
        "EliminarAcomodosPorPrograma", "EnsambleTieneAcomodos", "LimpiarAcomodosPorEnsamble",
        "GetMaterialesPorPrograma", "GetDetallesPrograma", "GetProgramasParaModal"
    };
}
<script>
var TG = { urls: {} };
@foreach (var a in tgActions)
{
    @:TG.urls["@(char.ToLowerInvariant(a[0]) + a.Substring(1))"] = "@Url.Action(a, "TrolleyGestion")";
}
</script>
<script src="@Url.Content("~/Scripts/trolley-gestion.min.js")?v=@(new System.IO.FileInfo(Server.MapPath("~/Scripts/trolley-gestion.min.js")).LastWriteTime.Ticks)"></script>
}
