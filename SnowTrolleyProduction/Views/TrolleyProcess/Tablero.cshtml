@{
    ViewBag.Title = "Tablero En Setup / Proceso";
}

@section Styles {
    <link href="~/Content/css/programa-gestion.css" rel="stylesheet" />
    <style>
        .tb-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
            gap: 16px;
        }
        .tb-linea-pill {
            background: #5d78ff;
            color: #fff;
            font-size: .7rem;
            font-weight: 700;
            border-radius: 20px;
            padding: 2px 10px;
            white-space: nowrap;
            flex-shrink: 0;
        }
        .tb-card-meta {
            display: flex;
            gap: 16px;
            flex-wrap: wrap;
            margin-bottom: 10px;
        }
        .tb-detail-item { min-width: 0; }
        .tb-detail-label {
            font-size: .68rem;
            color: #9aa0b8;
            font-weight: 600;
            text-transform: uppercase;
            margin-bottom: 2px;
        }
        .tb-detail-value {
            font-size: .84rem;
            font-weight: 700;
            color: #3d4465;
        }
        .tb-detail-value.muted { font-weight: 400; color: #646c9a; }
        .tb-trolleys {
            display: flex;
            flex-wrap: wrap;
            gap: 4px;
            margin-top: 8px;
            padding-top: 8px;
            border-top: 1px solid #f0f2f8;
        }
        .tb-empty {
            grid-column: 1 / -1;
            text-align: center;
            padding: 52px 0;
            color: #b0b7d0;
        }
        img.show-empty { width:280px!important;height:280px!important;background-size:280px 280px!important;display:block!important;margin:0 auto!important; }
        .tb-live-dot {
            width: 8px; height: 8px; border-radius: 50%;
            background: #22c55e; display: inline-block;
            margin-right: 4px; animation: tb-blink 2s infinite;
        }
        @@keyframes tb-blink { 0%,100%{opacity:1} 50%{opacity:.25} }
        .k-card-header { display: flex; align-items: center; justify-content: space-between; gap: 8px; }
        .k-card-title { white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
    </style>
}

<div class="ts-header">
    <h4>
        <i class="fas fa-tv" style="margin-right:8px;"></i>
        Tablero En Setup / Proceso
    </h4>
    <div style="display:flex;gap:8px;align-items:center;">
        <span style="font-size:.75rem;color:#9aa0b8;">
            <span class="tb-live-dot"></span>En vivo &nbsp;&nbsp;
            <span id="lblHora"></span>
        </span>
        <a href="@Url.Action("Operadores","TrolleyProcess")" class="k-button btn-rounded">
            <i class="fas fa-hard-hat"></i> Tablero Operadores
        </a>
        <a href="@Url.Action("Index","TrolleyProcess")" class="k-button btn-rounded">
            <i class="fas fa-chevron-left"></i> Plan de Produccion
        </a>
    </div>
</div>

<div class="tb-grid" id="tableroGrid"></div>

@section Scripts {
    <script>
        var URL_RESUMEN = '@Url.Action("ObtenerResumenSetup","TrolleyProcess")';

        function badgeStatus(s) {
            return s === 'Arranque'
                ? '<span class="k-badge k-badge-solid k-badge-success" style="padding:2px 9px;font-size:.72rem;font-weight:700;"><i class="fas fa-play-circle"></i> Arranque</span>'
                : '<span class="k-badge k-badge-solid k-badge-warning" style="padding:2px 9px;font-size:.72rem;font-weight:700;"><i class="fas fa-cog"></i> Setup</span>';
        }

        function horaDesde(dateStr) {
            if (!dateStr) return '';
            var ms = parseInt(dateStr.replace(/\/Date\((-?\d+)[^)]*\)\//, '$1'));
            if (isNaN(ms)) return '';
            var d = new Date(ms);
            return d.getHours().toString().padStart(2,'0') + ':' +
                   d.getMinutes().toString().padStart(2,'0');
        }

        function renderTablero(data) {
            var grid = $('#tableroGrid').empty();

            if (!data || !data.length) {
                grid.append(
                    '<div class="tb-empty">' +
                    '<div class="k-grid" style="border:none;background:transparent;overflow:visible;height:auto;box-shadow:none;"><img class="show-empty" /></div>' +
                    '</div>'
                );
                return;
            }

            $.each(data, function (_, t) {
                var tBadges = '';
                if (t.trolleys) {
                    $.each(t.trolleys.split(','), function (_, tr) {
                        tr = tr.trim();
                        if (tr) tBadges += '<span class="k-badge k-badge-solid k-badge-success" style="font-size:.7rem;font-weight:700;padding:2px 8px;">' + tr + '</span>';
                    });
                }
                if (!tBadges) {
                    tBadges = '<span style="color:#b0b7d0;font-size:.75rem;"><i class="fas fa-exclamation-circle"></i> Sin trolleys asignados</span>';
                }

                var card =
                    '<div class="k-card">' +

                    '<div class="k-card-header">' +
                    '<span class="k-card-title" style="color:#3d4465;">' +
                    '<i class="fas fa-layer-group" style="margin-right:5px;"></i>' +
                    (t.ensamble || t.id_Programa) +
                    '</span>' +
                    '<div style="display:flex;gap:5px;align-items:center;">' +
                    '<span class="tb-linea-pill">L' + t.linea + '</span>' +
                    badgeStatus(t.status) +
                    '</div>' +
                    '</div>' +

                    '<div class="k-card-body">' +

                    '<div class="tb-card-meta">' +

                    '<div class="tb-detail-item">' +
                    '<div class="tb-detail-label">Programa</div>' +
                    '<div class="tb-detail-value">' + (t.id_Programa || '') + '</div>' +
                    '</div>' +

                    '<div class="tb-detail-item">' +
                    '<div class="tb-detail-label">Work Order</div>' +
                    '<div class="tb-detail-value muted">' + (t.workOrder || '') + '</div>' +
                    '</div>' +

                    '<div class="tb-detail-item">' +
                    '<div class="tb-detail-label">Pzas. Prog.</div>' +
                    '<div class="tb-detail-value muted">' +
                    (t.piezasProgramadas > 0 ? t.piezasProgramadas : '') +
                    '</div>' +
                    '</div>' +

                    '<div class="tb-detail-item">' +
                    '<div class="tb-detail-label">Inicio</div>' +
                    '<div class="tb-detail-value muted">' +
                    '<i class="fas fa-clock" style="margin-right:3px;"></i>' +
                    horaDesde(t.fechaCreacion) +
                    '</div>' +
                    '</div>' +

                    '</div>' +

                    '<div class="tb-trolleys">' + tBadges + '</div>' +

                    '</div>' +
                    '</div>';

                grid.append(card);
            });
        }

        function actualizar() {
            $.get(URL_RESUMEN, function (data) {
                renderTablero(data);
            }).fail(function () {
                $('#tableroGrid').html(
                    '<div class="tb-empty">' +
                    '<i class="fas fa-exclamation-triangle" style="color:#ef4444;"></i>' +
                    '<strong>Error de conexion</strong>Reintentando en 30 segundos...' +
                    '</div>'
                );
            });

            var now = new Date();
            $('#lblHora').text(
                now.getHours().toString().padStart(2,'0') + ':' +
                now.getMinutes().toString().padStart(2,'0') + ':' +
                now.getSeconds().toString().padStart(2,'0')
            );
        }

        actualizar();
        setInterval(actualizar, 30000);
    </script>
}
