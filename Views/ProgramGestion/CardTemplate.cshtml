<style>
    .ts-card {
        width: calc(33.333% - 10px);
        min-width: 260px;
        background: #fff;
        border: 1px solid #e8ecf1;
        border-radius: 10px;
        box-shadow: 0 1px 5px rgba(0,0,0,.06);
        padding: 14px 16px 12px;
        box-sizing: border-box;
        position: relative;
        transition: box-shadow .15s;
    }

        .ts-card:hover {
            box-shadow: 0 4px 14px rgba(0,0,0,.1);
        }

    .ts-card-num {
        position: absolute;
        top: -10px;
        left: 14px;
        background: #5d78ff;
        color: #fff;
        font-size: .72rem;
        font-weight: 700;
        border-radius: 20px;
        padding: 2px 9px;
    }

    .ts-card-title {
        font-size: .9rem;
        font-weight: 700;
        color: #3d4465;
        margin: 8px 0 2px;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    .ts-card-sub {
        font-size: .78rem;
        color: #9aa0b8;
        margin-bottom: 10px;
    }

    .ts-card-trolleys {
        font-size: .74rem;
        color: #9aa0b8;
        margin-top: 6px;
    }

    .ts-badge {
        display: inline-block;
        padding: 3px 10px;
        border-radius: 20px;
        font-size: .71rem;
        font-weight: 700;
        white-space: nowrap;
    }

        .ts-badge.open {
            background: #fff8ec;
            color: #f59e0b;
            border: 1px solid #fde68a;
        }

        .ts-badge.proc {
            background: #eff6ff;
            color: #3b82f6;
            border: 1px solid #bfdbfe;
        }

        .ts-badge.done {
            background: #f0fdf4;
            color: #22c55e;
            border: 1px solid #bbf7d0;
        }

    .ts-card-meta {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-top: 10px;
        font-size: .75rem;
        color: #9aa0b8;
        border-top: 1px solid #f0f2f8;
        padding-top: 9px;
    }

        .ts-card-meta span {
            display: flex;
            align-items: center;
            gap: 4px;
        }

    .ts-card-actions {
        display: flex;
        gap: 6px;
        margin-top: 10px;
    }

        .ts-card-actions a {
            flex: 1;
            text-align: center;
            padding: 5px;
            border-radius: 6px;
            font-size: .75rem;
            font-weight: 600;
            border: 1px solid #e8ecf1;
            color: #646c9a;
            text-decoration: none;
            transition: background .12s;
        }

            .ts-card-actions a:hover {
                background: #f7f8fc;
            }

            .ts-card-actions a.del {
                color: #ef4444;
                border-color: #fecaca;
            }

                .ts-card-actions a.del:hover {
                    background: #fff5f5;
                }
</style>

<script type="text/x-kendo-tmpl" id="cardTemplate">
    # var badgeCls = Status === 'Completado' ? 'done' : (Status === 'En Proceso' ? 'proc' : 'open'); #
    # var badgeIco = Status === 'Completado' ? 'fa-check-circle' : (Status === 'En Proceso' ? 'fa-cog' : 'fa-clock'); #
    # var _fd = FechaCreacion instanceof Date ? FechaCreacion : new Date(parseInt(FechaCreacion.replace('/Date(','').replace(')/',''))); #
    # var fecha = _fd && !isNaN(_fd) ? (_fd.getDate().toString().padStart(2,'0') + '/' + (_fd.getMonth()+1).toString().padStart(2,'0') + '/' + _fd.getFullYear()) : '—'; #
    <div class="ts-card">
        <span class="ts-card-num">\##=Id#</span>
        <div style="margin-top:6px;">
            <span class="ts-badge #=badgeCls#">
                <i class="fas #=badgeIco#"></i>&nbsp;#=Status#
            </span>
        </div>
        <div class="ts-card-title">Prog: #=Id_Programa || '&mdash;'#</div>
        <div class="ts-card-sub">WO: #=WorkOrder#</div>
        # if (Trolleys) { #
        <div class="ts-card-trolleys">
            <i class="fas fa-grip-lines"></i>&nbsp;#=Trolleys#
        </div>
        # } #
        <div class="ts-card-meta">
            <span><i class="fas fa-calendar-alt"></i>&nbsp;#=fecha#</span>
            <span><i class="fas fa-boxes"></i>&nbsp;#=PiezasProgramadas# pzas</span>
            <span><i class="fas fa-industry"></i>&nbsp;L#=Id_Linea || '?'#</span>
        </div>
        <div class="ts-card-actions">
            <a role="button" class="k-edit-button" href="\#">
                <i class="fas fa-edit"></i> Editar
            </a>
            <a role="button" class="k-delete-button del" href="\#">
                <i class="fas fa-trash-alt"></i> Eliminar
            </a>
        </div>
    </div>
</script>
