@model List<SnowTrolleyProduction.Models.EnsambleGestion>

<table class="table table-striped gestion-table">
    <thead>
        <tr>
            <th>Ensamble</th>
            <th>Línea</th>
            <th style="width:1%;white-space:nowrap;">Acciones</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var ens in Model)
        {
            <tr>
                <td>@ens.Numero</td>
                <td>@(ens.Linea != null ? ens.Linea.Numero_Linea.ToString() : "--")</td>
                <td style="white-space:nowrap;">
                    <button class="k-button btn-rounded btn-edit-ensamble" data-id="@ens.Id"><i class="fas fa-edit"></i> Editar</button>
                    <button class="k-button btn-rounded btn-del-ensamble" data-id="@ens.Id" style="color:#ef4444;border-color:#fecaca;"><i class="fas fa-trash-alt"></i> Eliminar</button>
                </td>
            </tr>
        }
    </tbody>
</table>
